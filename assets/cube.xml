<!-- PROTOCOL 4 scene. Mass and inertia are placeholders; Simulator.set_cube overwrites them
     (mass m, inertia m*s^2/6 per axis, s = 0.05) and calls mj_setConst. -->
<!-- Deviation from MuJoCo defaults (not in PROTOCOL 4): solimp 0.99 0.999 0.001 on both geoms.
     With default solimp the cube rests 0.108 mm below 0.025 m, outside the G1 settling tolerance
     of 1e-4 m; with it the sag is 0.010 mm. See docs/handoffs/T01.md. -->
<mujoco model="push_cube">
  <compiler angle="degree"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.1" friction="0 0 0" condim="3" solimp="0.99 0.999 0.001"/>
    <body name="cube" pos="0 0 0.025">
      <freejoint name="cube_free"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.000416667 0.000416667 0.000416667"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" friction="0.4 0.005 0.0001" condim="3" solimp="0.99 0.999 0.001"/>
    </body>
  </worldbody>
</mujoco>
