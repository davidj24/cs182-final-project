<!-- IDEALIZED 1D TRANSLATIONAL PUSHER (PILOT_SPEC A4). One body, one x slide joint, no other DoF.
     Horizontal friction is MuJoCo joint dry friction (frictionloss = mu*m*g, set per cube at runtime
     by Simulator.set_cube; assumes N = m*g). Floor and cube box geoms are VISUAL ONLY: contype and
     conaffinity are 0, so no contact is ever generated. Cube side 0.05 m (half-size 0.025).
     Mass and inertia are placeholders; Simulator.set_cube overwrites them (inertia m*s^2/6) and
     calls mj_setConst. -->
<mujoco model="push_cube_1d">
  <compiler angle="degree"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="floor" type="plane" size="1 0.2 0.1" contype="0" conaffinity="0" rgba="0.8 0.8 0.8 1"/>
    <body name="cube" pos="0 0 0.025">
      <joint name="x" type="slide" axis="1 0 0" damping="0" frictionloss="0"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.000416667 0.000416667 0.000416667"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" contype="0" conaffinity="0" rgba="0.2 0.4 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
